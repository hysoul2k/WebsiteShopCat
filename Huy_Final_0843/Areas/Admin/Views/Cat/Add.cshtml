@model Huy_Final_0843.Models.Cat
@{
    ViewData["Title"] = "Thêm Mèo";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h3 class="fw-bold m-0"><i class="fas fa-cat me-2"></i>Thêm Mèo Mới</h3>
</div>

<div class="glass-card" style="max-width:700px;">
    <form asp-action="Add" method="post" enctype="multipart/form-data">

        <div class="form-group mb-3">
            <label asp-for="Name" class="fw-bold">Tên mèo</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên mèo..." />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Price" class="fw-bold">Giá (đ)</label>
                <input asp-for="Price" type="number" min="0" class="form-control" placeholder="0" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Age" class="fw-bold">Tuổi (tháng)</label>
                <input asp-for="Age" type="number" min="0" max="360" class="form-control" placeholder="0" />
                <span asp-validation-for="Age" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Gender" class="fw-bold">Giới tính</label>
            <select asp-for="Gender" class="form-select">
                <option value="Không rõ">❓ Không rõ</option>
                <option value="Đực">♂ Đực</option>
                <option value="Cái">♀ Cái</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="fw-bold">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-group mb-4">
            <label class="fw-bold">Ảnh mèo</label>
            <input type="file" name="imageUrl" accept="image/*" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark px-4"><i class="fas fa-plus me-2"></i>Thêm mèo</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
