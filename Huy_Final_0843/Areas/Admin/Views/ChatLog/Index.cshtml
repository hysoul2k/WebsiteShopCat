@{
    ViewData["Title"] = "Lịch sử Chat";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Lịch sử Chat</h1>
    </div>

    <!-- Filters -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <input type="text" id="sessionFilter" class="form-control" placeholder="Session ID...">
                </div>
                <div class="col-md-3 mb-3">
                    <select id="intentFilter" class="form-control">
                        <option value="">-- Tất cả chủ đề --</option>
                        <option value="cat">Mèo</option>
                        <option value="food">Thức ăn</option>
                        <option value="accessory">Phụ kiện</option>
                        <option value="order">Đơn hàng</option>
                        <option value="policy">Chính sách</option>
                        <option value="shipping">Vận chuyển</option>
                        <option value="cat_care">Chăm sóc mèo</option>
                        <option value="general">Khác</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <input type="date" id="fromDate" class="form-control">
                </div>
                <div class="col-md-2 mb-3">
                    <input type="date" id="toDate" class="form-control">
                </div>
                <div class="col-md-2 mb-3">
                    <button class="btn btn-primary w-100" onclick="fetchLogs()"><i class="fas fa-search"></i> Lọc</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th width="20%">Session ID</th>
                            <th width="20%">Tài khoản</th>
                            <th width="30%">Tin nhắn</th>
                            <th width="12%">Chủ đề</th>
                            <th width="12%">Thời gian</th>
                            <th width="6%"></th>
                        </tr>
                    </thead>
                    <tbody id="logTableBody">
                        <tr><td colspan="6" class="text-center">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            fetchLogs();
        });

        function fetchLogs() {
            let params = new URLSearchParams();
            let session = $('#sessionFilter').val();
            let intent = $('#intentFilter').val();
            let from = $('#fromDate').val();
            let to = $('#toDate').val();
            if (session) params.append('sessionId', session);
            if (intent) params.append('intent', intent);
            if (from) params.append('from', from);
            if (to) params.append('to', to);

            $.get('/admin/chatlogs/api?' + params.toString(), function (data) {
                if (!data.length) {
                    $('#logTableBody').html('<tr><td colspan="6" class="text-center">Không có dữ liệu</td></tr>');
                    return;
                }
                let html = '';
                data.forEach(function (row) {
                    let intentBadge = getIntentBadge(row.intent);
                    let date = new Date(row.createdAt).toLocaleString('vi-VN');
                    let shortSession = row.sessionId.length > 20 ? row.sessionId.substring(0, 20) + '...' : row.sessionId;
                    let shortMsg = row.messageContent.length > 60 ? row.messageContent.substring(0, 60) + '...' : row.messageContent;
                    html += `<tr>
                        <td><small class="text-muted" title="${row.sessionId}">${shortSession}</small></td>
                        <td>${row.accountEmail || '<span class="text-muted">Khách</span>'}</td>
                        <td>${shortMsg}</td>
                        <td>${intentBadge}</td>
                        <td><small>${date}</small></td>
                        <td><a href="/admin/chatlogs/session/${encodeURIComponent(row.sessionId)}" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></a></td>
                    </tr>`;
                });
                $('#logTableBody').html(html);
            });
        }

        function getIntentBadge(intent) {
            const map = {
                'cat': '<span class="badge badge-primary">Mèo</span>',
                'food': '<span class="badge badge-success">Thức ăn</span>',
                'accessory': '<span class="badge badge-info">Phụ kiện</span>',
                'order': '<span class="badge badge-warning">Đơn hàng</span>',
                'policy': '<span class="badge badge-secondary">Chính sách</span>',
                'shipping': '<span class="badge badge-dark">Vận chuyển</span>',
                'cat_care': '<span class="badge badge-light">Chăm sóc</span>',
                'general': '<span class="badge badge-secondary">Khác</span>'
            };
            return map[intent] || `<span class="badge badge-secondary">${intent || 'N/A'}</span>`;
        }
    </script>
}
