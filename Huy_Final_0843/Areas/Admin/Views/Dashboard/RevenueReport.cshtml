@model Huy_Final_0843.Models.RevenueReportViewModel

@{
    ViewData["Title"] = "Báo Cáo Doanh Thu (Showcase)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="fas fa-chart-line me-2" style="color: var(--accent-color);"></i>THỐNG KÊ DOANH THU & HIỆU SUẤT TỔNG</h3>
</div>

<style>
    /* NÚT LỌC ĐỎ CHIẾN (USER REQUEST - CLONE TỪ REVENUESTATS) */
    .btn-action-red {
        background-color: #dc3545 !important;
        color: white !important;
        border: none;
        font-weight: bold;
        z-index: 1000;
        position: relative;
        transition: all 0.3s ease;
    }
    .btn-action-red:hover {
        background-color: #c82333 !important;
        box-shadow: 0 0 15px rgba(220, 53, 69, 0.6) !important;
        transform: scale(1.02);
    }
</style>

<!-- KHỐI BỘ LỌC (FILTER) -->
<div class="glass-card p-4 mb-4 border-secondary text-white bg-dark shadow">
    <form method="get" asp-area="Admin" asp-controller="Dashboard" asp-action="RevenueReport" class="row gx-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-uppercase small fw-bold text-secondary mb-2">Chọn Tháng</label>
            <select name="month" class="form-select bg-dark text-white border-secondary">
                @for (int i = 1; i <= 12; i++)
                {
                    if (Model.SelectedMonth == i)
                    {
                        <option value="@i" selected>Tháng @i</option>
                    }
                    else
                    {
                        <option value="@i">Tháng @i</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label text-uppercase small fw-bold text-secondary mb-2">Chọn Năm</label>
            <select name="year" class="form-select bg-dark text-white border-secondary">
                @foreach (var yr in Model.AvailableYears)
                {
                    if (Model.SelectedYear == yr)
                    {
                        <option value="@yr" selected>Năm @yr</option>
                    }
                    else
                    {
                        <option value="@yr">Năm @yr</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-action-red w-100 py-2">
                <i class="fas fa-rocket me-2"></i>TRÍCH XUẤT DỮ LIỆU
            </button>
        </div>
    </form>
</div>

<!-- DẢI THẺ KẾT QUẢ -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card glass-card h-100 p-4 border-secondary text-white bg-dark shadow text-center">
            <h5 class="fw-bold mb-3 text-secondary text-uppercase"><i class="fas fa-coins me-2 text-warning"></i>Doanh Thu Tháng @Model.SelectedMonth/@Model.SelectedYear</h5>
            <h1 class="display-5 fw-bold mt-auto pb-2" style="color: var(--accent-color);">
                @Model.TotalRevenue.ToString("N0") <span class="fs-4">VNĐ</span>
            </h1>
            @if (Model.TotalRevenue == 0)
            {
                <div class="alert mt-2 p-1 border-0 fw-bold animate__animated animate__fadeIn" style="color: #bc8f8f; background: transparent;">
                    <i class="fas fa-info-circle me-1"></i> Không có dữ liệu doanh thu cho tháng này
                </div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card glass-card h-100 p-4 border-secondary text-white bg-dark shadow text-center">
            <h5 class="fw-bold mb-3 text-secondary text-uppercase"><i class="fas fa-calendar-check me-2 text-info"></i>Số Đơn Đã Chốt</h5>
            <h1 class="display-5 fw-bold mt-auto pb-2 text-white">
                @Model.OrdersThisMonth <span class="fs-4" style="color: var(--accent-color);">Giao Dịch</span>
            </h1>
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ DOANH THU (CHART.JS) -->
<div class="glass-card p-4 mb-5 shadow bg-dark">
    <h5 class="fw-bold mb-4 text-white"><i class="fas fa-chart-area me-2 text-primary"></i>BIẾN ĐỘNG DOANH THU HÀNG NGÀY (Tháng @Model.SelectedMonth)</h5>
    <div style="height: 350px;">
        <canvas id="revenueChart"></canvas>
    </div>
</div>

<div class="glass-card p-4">
    <h5 class="fw-bold mb-4 text-white"><i class="fas fa-trophy me-2 text-warning"></i>TOP 5 SẢN PHẨM BÁN CHẠY (Tháng @Model.SelectedMonth)</h5>

    <div class="table-responsive">
        <table class="table table-dark table-hover table-bordered border-secondary m-0 text-center align-middle shadow">
            <thead class="bg-secondary bg-opacity-25">
                <tr class="text-uppercase small text-secondary">
                    <th style="width: 5%">Hạng</th>
                    <th style="width: 10%">Hình Ảnh</th>
                    <th class="text-start">Tên Sản Phẩm</th>
                    <th>SL Bán</th>
                    <th class="text-end">Doanh Thu (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TopSellingProducts != null && Model.TopSellingProducts.Any())
                {
                    int rank = 1;
                    foreach (var item in Model.TopSellingProducts)
                    {
                        <tr>
                            <td class="fw-bold fs-5 text-warning">#@rank</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" class="rounded product-image-square shadow-sm" style="width: 48px; border: 1px solid rgba(255,255,255,0.1);" />
                                }
                            </td>
                            <td class="text-start fw-bold text-white">@item.ProductName</td>
                            <td><span class="badge bg-rosy">@item.TotalSold</span></td>
                            <td class="text-end fw-bold" style="color: var(--accent-color);">@item.TotalRevenueGenerated.ToString("N0")</td>
                        </tr>
                        rank++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-5 text-muted fst-italic">Không có dữ liệu bán hàng trong tháng này...</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Dữ liệu từ Model
            const labels = @Html.Raw(Json.Serialize(Model.ChartLabels));
            const dataValues = @Html.Raw(Json.Serialize(Model.ChartData));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: dataValues,
                        borderColor: '#bc8f8f',
                        backgroundColor: 'rgba(188, 143, 143, 0.2)',
                        borderWidth: 3,
                        pointBackgroundColor: '#bc8f8f',
                        pointOffset: 5,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { 
                                color: '#aaa',
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#aaa' }
                        }
                    }
                }
            });
        });
    </script>
}
