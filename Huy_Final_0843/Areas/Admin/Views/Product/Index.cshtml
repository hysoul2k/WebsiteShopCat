@model IEnumerable<Huy_Final_0843.Models.Product>
@{
    ViewData["Title"] = "Quản lý Thú Cưng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0"><i class="fas fa-list me-2"></i>Danh Sách Thú Cưng</h3>
    @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Staff)) {
        <a asp-action="Add" class="btn btn-neon px-4"><i class="fas fa-plus me-2"></i>THÊM THÚ CƯNG</a>
    }
</div>

<div class="table-responsive">
    <table id="productTable" class="table table-dark table-hover border-secondary">
        <thead>
            <tr class="text-secondary text-uppercase small">
                <th>Thú Cưng</th>
                <th>Thông Tin Chi Tiết</th>
                <th class="text-center">Kho</th>
                <th class="text-center">Đơn Giá</th>
                <th class="text-end">Quản Lý</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td style="width: 100px;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                            <img src="@item.ImageUrl" class="rounded-3 shadow product-image-square" style="width:80px; border: 1px solid #3d444d;" />
                        }
                    </td>
                    <td>
                        <div class="fw-bold text-white fs-5">@item.Name</div>
                        <div class="text-secondary small">@item.Description</div>
                    </td>
                    <td class="text-center align-middle">
                        @if (item.StockQuantity > 0)
                        {
                            <span class="badge bg-success bg-opacity-25 text-success border border-success p-2">@item.StockQuantity Bé</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger p-2">Hết Số Lượng</span>
                        }
                    </td>
                    <td class="text-center align-middle">
                        <span class="text-white fw-bold">@item.Price.ToString("N0")</span> 
                        <span style="color: var(--accent-color);">đ</span>
                    </td>
                    <td class="text-end">
                        <div class="btn-group shadow-sm">
                            <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm"><i class="fas fa-eye"></i></a>
                            @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Staff)) {
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm"><i class="fas fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash-can"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                "language": {
                    "search": "",
                    "searchPlaceholder": "Tìm kiếm thú cưng...",
                    "paginate": { "previous": "Trước", "next": "Sau" }
                }
            });
            $('.dataTables_filter input').addClass('form-control bg-dark border-secondary text-white rounded-pill px-4 mb-3');
        });
    </script>
}