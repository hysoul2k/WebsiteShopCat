@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <h1 class="auth-title">Tạo tài khoản mới</h1>
        <p class="auth-subtitle">Tham gia cộng đồng Boss Meow Garden ngay!</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <div class="mb-3">
                <label class="auth-label">Họ và Tên</label>
                <input asp-for="Input.FullName" class="auth-input" autocomplete="name"
                       placeholder="Nguyễn Văn A" />
                <span asp-validation-for="Input.FullName" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <label class="auth-label">Email</label>
                <input asp-for="Input.Email" class="auth-input" autocomplete="username"
                       placeholder="example@email.com" type="email" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <label class="auth-label">Mật Khẩu</label>
                <input asp-for="Input.Password" class="auth-input" autocomplete="new-password"
                       placeholder="Tối thiểu 6 ký tự" type="password" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <label class="auth-label">Xác Nhận Mật Khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password"
                       placeholder="Nhập lại mật khẩu" type="password" />
                <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-auth">
                <i class="fas fa-user-plus me-2"></i>Tạo Tài Khoản
            </button>
        </form>

        <div class="auth-divider"></div>

        <p class="auth-register-link">
            Đã có tài khoản?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
