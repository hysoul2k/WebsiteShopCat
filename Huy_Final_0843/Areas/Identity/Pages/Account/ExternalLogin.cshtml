@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Hoàn Tất Đăng Ký";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <h1 class="auth-title">Xác nhận tài khoản</h1>
        <p class="auth-subtitle">
            Đăng nhập thành công qua <strong>@Model.ProviderDisplayName</strong>.<br>
            Xác nhận email để hoàn tất.
        </p>

        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <div class="mb-4">
                <label class="auth-label">Email</label>
                <input asp-for="Input.Email" class="auth-input" type="email"
                       placeholder="Xác nhận email của bạn" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-check me-2"></i>Hoàn Tất Đăng Ký
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
