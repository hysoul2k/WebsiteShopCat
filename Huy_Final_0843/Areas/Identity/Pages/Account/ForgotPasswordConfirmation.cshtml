@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Kiểm tra email";
}

<div class="auth-wrapper">
    <div class="auth-card text-center">
        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <div style="font-size:48px; margin-bottom:16px;">📧</div>
        <h1 class="auth-title">Kiểm tra hộp thư!</h1>
        <p class="auth-subtitle">
            Nếu email của bạn tồn tại trong hệ thống, chúng tôi đã gửi link đặt lại mật khẩu.<br/>
            Vui lòng kiểm tra hộp thư (kể cả mục Spam).
        </p>

        <a asp-page="./Login" class="btn-auth" style="display:block; text-align:center; margin-top:24px; text-decoration:none;">
            <i class="fas fa-arrow-left me-2"></i>Quay lại đăng nhập
        </a>
    </div>
</div>
