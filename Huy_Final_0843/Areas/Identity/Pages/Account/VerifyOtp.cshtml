@page
@model VerifyOtpModel
@{
    ViewData["Title"] = "Xác Nhận OTP";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <h1 class="auth-title">Xác nhận tài khoản</h1>
        <p class="auth-subtitle">
            Mã OTP 6 số đã được gửi đến<br>
            <strong>@Model.Email</strong>
        </p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="auth-error" style="background:#f0f4ec; color:#2D5016; border-color:#2D5016;">
                <i class="fas fa-check-circle me-2"></i>@Model.StatusMessage
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-4">
                <label class="auth-label">Mã OTP</label>
                <input asp-for="Otp" class="auth-input" placeholder="000000"
                       maxlength="6" inputmode="numeric" pattern="[0-9]*"
                       style="font-size:28px; letter-spacing:10px; text-align:center;" autocomplete="one-time-code" />
                <span asp-validation-for="Otp" class="auth-field-error"></span>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-check me-2"></i>Xác Nhận
            </button>
        </form>

        <div class="auth-divider"></div>

        <form method="post" asp-page-handler="Resend">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ReturnUrl" />
            <p style="text-align:center; font-size:13px; color:var(--color-text-muted);">
                Không nhận được mã?
                <button type="submit"
                        style="background:none; border:none; padding:0; color:var(--color-primary); font-weight:600; font-size:13px; cursor:pointer; text-decoration:underline;">
                    Gửi lại
                </button>
            </p>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
