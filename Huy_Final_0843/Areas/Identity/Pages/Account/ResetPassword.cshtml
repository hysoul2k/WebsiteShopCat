@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <h1 class="auth-title">Đặt lại mật khẩu</h1>
        <p class="auth-subtitle">Nhập mật khẩu mới cho tài khoản của bạn</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <input type="hidden" asp-for="Input.Code" />

            <div class="mb-4">
                <label class="auth-label">Email</label>
                <input asp-for="Input.Email" class="auth-input" readonly style="opacity:.7;" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="mb-4">
                <label class="auth-label">Mật khẩu mới</label>
                <input asp-for="Input.Password" class="auth-input" type="password" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <div class="mb-4">
                <label class="auth-label">Xác nhận mật khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="auth-input" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="btn-auth">
                <i class="fas fa-lock me-2"></i>Đặt lại mật khẩu
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
