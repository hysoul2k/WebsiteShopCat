@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-logo">
            <img src="/images/logo.jpg" alt="Meow Garden" />
            <span class="brand">Meow Garden</span>
            <span class="sub">Thiên Đường Thú Cưng</span>
        </div>

        <h1 class="auth-title">Chào mừng trở lại</h1>
        <p class="auth-subtitle">Đăng nhập để tiếp tục mua sắm cùng Boss</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">
                <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
            </div>
        }

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

            <div class="mb-4">
                <label class="auth-label">Email</label>
                <input asp-for="Input.Email" class="auth-input" autocomplete="username"
                       placeholder="example@email.com" type="email" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="auth-label mb-0">Mật Khẩu</label>
                    <a asp-page="./ForgotPassword"
                       style="font-size:12px; color:var(--color-text-muted); text-decoration:none;"
                       onmouseover="this.style.color='var(--color-primary)'"
                       onmouseout="this.style.color='var(--color-text-muted)'">Quên mật khẩu?</a>
                </div>
                <input asp-for="Input.Password" class="auth-input" autocomplete="current-password"
                       placeholder="••••••••" type="password" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <label class="auth-remember">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                Ghi nhớ đăng nhập
            </label>

            <button id="login-submit" type="submit" class="btn-auth">
                <i class="fas fa-sign-in-alt me-2"></i>Đăng Nhập
            </button>
        </form>

        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="auth-divider" style="position:relative;">
                <span style="position:absolute; top:-10px; left:50%; transform:translateX(-50%); background:var(--color-surface); padding:0 12px; font-size:12px; color:var(--color-text-muted); white-space:nowrap;">hoặc tiếp tục với</span>
            </div>

            <form id="external-account" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" style="display:flex; flex-direction:column; gap:12px;">
                @foreach (var provider in Model.ExternalLogins)
                {
                    @if (provider.Name == "Google")
                    {
                        <button type="submit" name="provider" value="Google" class="btn-social" style="background:#fff; border:1.5px solid #E0E0E0; color:#3c4043;">
                            <svg width="18" height="18" viewBox="0 0 48 48" style="flex-shrink:0;"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
                            Đăng nhập với Google
                        </button>
                    }
                    else if (provider.Name == "Facebook")
                    {
                        <button type="submit" name="provider" value="Facebook" class="btn-social" style="background:#1877F2; border:1.5px solid #1877F2; color:#fff;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" style="flex-shrink:0;"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            Đăng nhập với Facebook
                        </button>
                    }
                    else
                    {
                        <button type="submit" name="provider" value="@provider.Name" class="btn-social" style="background:#f5f5f5; border:1.5px solid #ddd; color:#333;">
                            <i class="fas fa-sign-in-alt" style="flex-shrink:0;"></i>
                            Đăng nhập với @provider.DisplayName
                        </button>
                    }
                }
            </form>
        }

        <div class="auth-divider"></div>

        <p class="auth-register-link">
            Chưa có tài khoản?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
        </p>

        <div class="auth-links">
            <a asp-page="./ResendEmailConfirmation">
                <i class="fas fa-envelope me-1"></i>Gửi lại email xác nhận
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
