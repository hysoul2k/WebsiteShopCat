@using Microsoft.AspNetCore.Identity
@using Huy_Final_0843.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a id="manage" class="btn-custom" style="color: var(--charcoal); text-decoration: none; font-size: 13px; font-weight: 500;" asp-area="" asp-controller="Account" asp-action="Index">
        <i class="fas fa-user-circle me-1" style="color: var(--terra);"></i>
        @(UserManager.GetUserAsync(User).Result?.FullName ?? "Khách")
    </a>
    @if (!(User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Staff)))
    {
        <a class="btn-custom ms-2" style="color: var(--charcoal); text-decoration: none; font-size: 13px; font-weight: 500;" asp-area="" asp-controller="Order" asp-action="MyOrders" title="Xem trạng thái đơn hàng">
            <i class="fas fa-shipping-fast me-1" style="color: var(--forest);"></i>Đơn hàng
        </a>
    }
    <form id="logoutForm" class="m-0 ms-2" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button id="logout" type="submit" class="btn-custom btn-ghost" style="padding: 6px 12px; font-size: 12px;">
            Đăng xuất
        </button>
    </form>
}
else
{
    <a class="btn-custom btn-ghost" id="register" asp-area="Identity" asp-page="/Account/Register">
        Đăng ký
    </a>
    <a class="btn-custom btn-primary-custom" id="login" asp-area="Identity" asp-page="/Account/Login">
        Đăng nhập
    </a>
}