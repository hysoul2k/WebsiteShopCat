@using Huy_Final_0843.Extensions
@using Huy_Final_0843.Models
@{
    // Đọc giỏ hàng từ Session để đếm tổng số lượng sản phẩm
    var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart");
    var cartCount = cart?.Items.Sum(i => i.Quantity) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Meow Garden Official</title>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    @await RenderSectionAsync("Meta", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- TOP BAR -->
    <div class="top-bar">
        🐱 Miễn phí vận chuyển đơn hàng trên 300.000đ &nbsp;·&nbsp; Đổi trả trong 7 ngày &nbsp;·&nbsp; Mở cửa 8:00 – 21:00 hàng ngày
    </div>

    <!-- HEADER -->
    <header class="main-header">
        <div class="header-inner">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo-wrap d-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/logo.jpg" alt="Meow Garden" style="height: 48px; width: 48px; border-radius: 50%; object-fit: cover;" />
                <div class="d-flex flex-column" style="line-height: 1.2;">
                    <span style="font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 700; color: var(--color-primary); letter-spacing: -0.01em;">Meow Garden</span>
                    <span style="font-family: 'DM Sans', sans-serif; font-size: 9px; color: var(--color-text-muted); letter-spacing: 0.05em; text-transform: uppercase;">Thiên Đường Thú Cưng</span>
                </div>
            </a>

            <nav class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Staff))
                {
                    <a asp-area="Admin" asp-controller="OrderManager" asp-action="Index" style="color: var(--color-primary); font-weight: 700;">Quản Trị Viên</a>
                }
            </nav>

            <div class="header-actions">
                <div class="search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <label for="nav-search-input" class="visually-hidden">Tìm kiếm sản phẩm</label>
                    <input type="text" id="nav-search-input" placeholder="Tìm pate, đồ chơi cho boss..." autocomplete="off" aria-label="Tìm kiếm sản phẩm">
                    <div id="search-results-container"></div>
                </div>
                
                <partial name="_LoginPartial" />
                <a id="cart-icon" asp-controller="ShoppingCart" asp-action="Index" class="btn-custom cart-btn" aria-label="Giỏ đồ">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Giỏ Đồ
                    <span class="cart-count" id="cart-count">@cartCount</span>
                </a>
            </div>
        </div>
    </header>

    <div class="main-section" style="min-height: 60vh;">
        @RenderBody()
    </div>

    <footer style="background: var(--color-surface); border-top: 1px solid var(--color-border); padding: 56px 24px 32px;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <div class="row g-5">
                <div class="col-md-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 mb-3 text-decoration-none">
                        <img src="/images/logo.jpg" alt="Meow Garden" style="height: 40px; width: 40px; border-radius: 50%; object-fit: cover;" />
                        <span style="font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 700; color: var(--color-primary);">Meow Garden</span>
                    </a>
                    <p class="small mb-3" style="color: var(--color-text-muted); line-height: 1.7;">Thiên đường phụ kiện thú cưng cao cấp.<br>Uy tín – Chất lượng – Tận tâm.</p>
                    <div class="d-flex gap-3">
                        <a href="https://facebook.com/hysoul2k" target="_blank" style="color: var(--color-text-muted); font-size: 17px; transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://zalo.me/0908758533" target="_blank" style="color: var(--color-text-muted); font-size: 17px; transition: color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='var(--color-text-muted)'"><i class="fas fa-phone-alt"></i></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6 style="font-family: 'DM Sans', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; color: var(--color-text-muted); margin-bottom: 20px;">Chính Sách</h6>
                    <ul class="list-unstyled mb-0" style="color: var(--color-text-muted); font-size: 14px; line-height: 2.2;">
                        <li><i class="fas fa-truck me-2" style="color: var(--color-primary); width: 16px;"></i>Miễn phí ship đơn trên 300.000đ</li>
                        <li><i class="fas fa-redo me-2" style="color: var(--color-primary); width: 16px;"></i>Đổi trả trong 7 ngày</li>
                        <li><i class="fas fa-shield-alt me-2" style="color: var(--color-primary); width: 16px;"></i>Sản phẩm chính hãng 100%</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 style="font-family: 'DM Sans', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; color: var(--color-text-muted); margin-bottom: 20px;">Liên Hệ</h6>
                    <ul class="list-unstyled mb-0" style="color: var(--color-text-muted); font-size: 14px; line-height: 2.2;">
                        <li><i class="fas fa-map-marker-alt me-2" style="color: var(--color-primary); width: 16px;"></i>TP. Hồ Chí Minh, Việt Nam</li>
                        <li><i class="fas fa-phone-alt me-2" style="color: var(--color-primary); width: 16px;"></i>0908 758 533</li>
                        <li><i class="fas fa-clock me-2" style="color: var(--color-primary); width: 16px;"></i>8:00 – 21:00 hàng ngày</li>
                    </ul>
                </div>
            </div>
            <div style="border-top: 1px solid var(--color-border); margin-top: 40px; padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <span style="font-size: 13px; color: var(--color-text-muted);">© @DateTime.Now.Year Meow Garden. Bảo lưu mọi quyền.</span>
                <span style="font-size: 13px; color: var(--color-text-muted);">Hệ thống Pet Shop Cao Cấp</span>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // --- SIGNALR: LẮNG NGHE CẬP NHẬT TRẠNG THÁI ---
            const conn = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .build();

            conn.on("ReceiveStatusUpdate", function (orderId, status, brand) {
                // Hiển thị thông báo Toast/Alert cho khách hàng
                alert("✨ [" + (brand || "Meow Garden") + "]: Đơn hàng #" + orderId + " của bạn đã được chuyển sang trạng thái: [" + status + "]");
            });

            conn.on("UpdateStock", function (productId, newStock) {
                // Tìm tất cả các container có data-product-id tương ứng
                const containers = document.querySelectorAll(`.stock-status-container[data-product-id="${productId}"]`);
                
                containers.forEach(container => {
                    const badge = container.querySelector(".stock-badge");
                    const addToCartForm = container.querySelector(".add-to-cart-form");
                    const outOfStockAlert = container.querySelector(".out-of-stock-alert");
                    const stockInfoArea = container.querySelector(".stock-info-area");
                    const stockInput = container.querySelector(".stock-input");

                    if (badge) {
                        if (newStock <= 0) {
                            badge.className = "badge bg-danger shadow fs-6 p-2 rounded-pill stock-badge";
                            badge.innerHTML = '<i class="fas fa-ban me-1"></i>Hết Hàng';
                            
                            // Ẩn form, hiện alert ở trang chi tiết
                            if (addToCartForm) addToCartForm.classList.add("d-none");
                            if (outOfStockAlert) outOfStockAlert.classList.remove("d-none");
                            if (stockInfoArea) stockInfoArea.classList.add("d-none");
                        } else {
                            if (newStock < 10) {
                                badge.className = "badge bg-warning text-dark shadow rounded-pill p-2 stock-badge";
                                badge.innerHTML = '<i class="fas fa-fire me-1"></i>Sắp Hết (' + newStock + ')';
                            } else {
                                badge.className = "badge bg-success shadow rounded-pill p-2 stock-badge";
                                badge.innerHTML = '<i class="fas fa-check me-1"></i>Còn hàng (' + newStock + ')';
                            }

                            // Hiện form, ẩn alert ở trang chi tiết
                            if (addToCartForm) {
                                addToCartForm.classList.remove("d-none");
                                if (stockInput) stockInput.max = newStock;
                            }
                            if (outOfStockAlert) outOfStockAlert.classList.add("d-none");
                            if (stockInfoArea) stockInfoArea.classList.remove("d-none");
                        }

                        // Hiệu ứng Visual Feedback
                        badge.style.transition = "all 0.5s";
                        badge.style.transform = "scale(1.2)";
                        setTimeout(() => badge.style.transform = "scale(1)", 500);
                    }
                });
            });

            conn.start().catch(err => console.error(err.toString()));
        });
    </script>
    <script>
        $(document).ready(function () {
            // --- XỬ LÝ CLICK THÊM GIỎ HÀNG AJAX & ANIMATION ---
            $(document).on('click', '.btn-add-to-cart-ajax', function (e) {
                e.preventDefault();
                const btn = $(this);
                const productId = btn.data('product-id');
                const quantity = btn.closest('form, div, .card-body').find('input[name="quantity"]').val() || 1;
                
                // Cải thiện selector để tìm được ảnh sản phẩm cho tất cả các nhóm (Mèo, Thức ăn, Dụng cụ)
                // Tìm trong Card, nếu không thấy thì tìm trong container gần nhất
                const productImage = btn.closest('.glass-card, .card, .container, .row').find('.product-image-target').first();

                // 1. Gửi AJAX lên Server
                $.ajax({
                    url: '/ShoppingCart/AddToCartAjax',
                    type: 'POST',
                    data: { productId: productId, quantity: quantity },
                    success: function (res) {
                        if (res.success) {
                            // 2. Chỉ thực hiện Animation nếu tìm thấy ảnh sản phẩm
                            if (productImage.length) {
                                flyToCart(productImage, $('#cart-icon'));
                            }

                            // 3. Hiển thị thông báo Toast
                            if (typeof window.showToast === 'function') {
                                window.showToast('Đã thêm [' + res.productName + '] vào giỏ hàng.', 'success');
                            } else {
                                Swal.fire('Thành công', 'Đã thêm ' + res.productName + ' vào giỏ hàng.', 'success');
                            }

                            // 4. Cập nhật Badge số lượng trên Navbar (sau khi animation xong)
                            setTimeout(function() {
                                $('#cart-count').text(res.cartCount);
                                $('#cart-icon').addClass('cart-shake');
                                setTimeout(() => $('#cart-icon').removeClass('cart-shake'), 500);
                            }, 900);
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Opps!', 'Có lỗi xảy ra khi thêm vào giỏ hàng.', 'error');
                    }
                });
            });

            function flyToCart(imgSource, cartTarget) {
                const imgClone = imgSource.clone()
                    .offset({
                        top: imgSource.offset().top,
                        left: imgSource.offset().left
                    })
                    .css({
                        'opacity': '0.8',
                        'position': 'absolute',
                        'height': '150px',
                        'width': '150px',
                        'z-index': '9999',
                        'border-radius': '50%',
                        'object-fit': 'cover'
                    })
                    .addClass('fly-to-cart-icon')
                    .appendTo($('body'))
                    .animate({
                        'top': cartTarget.offset().top + 10,
                        'left': cartTarget.offset().left + 10,
                        'width': 20,
                        'height': 20
                    }, 1000, 'easeInOutExpo');

                imgClone.animate({
                    'width': 0,
                    'height': 0
                }, function () {
                    $(this).detach();
                });
            }

            // Mở rộng hiệu ứng animate (nếu cần mượt hơn)
            jQuery.extend(jQuery.easing, {
                easeInOutExpo: function (x, t, b, c, d) {
                    if (t == 0) return b;
                    if (t == d) return b + c;
                    if ((t /= d / 2) < 1) return c / 2 * Math.pow(2, 10 * (t - 1)) + b;
                    return c / 2 * (-Math.pow(2, -10 * --t) + 2) + b;
                }
            });

            // --- LIVE SEARCH LOGIC (DEBOUNCE) ---
            let searchTimeout;
            $('#nav-search-input').on('input', function () {
                const term = $(this).val().trim();
                const container = $('#search-results-container');

                clearTimeout(searchTimeout);

                if (term.length < 2) {
                    container.hide().empty();
                    return;
                }

                searchTimeout = setTimeout(function () {
                    $.ajax({
                        url: '/Product/SearchSuggest',
                        type: 'GET',
                        data: { term: term },
                        success: function (res) {
                            container.empty().show();
                            if (res.length > 0) {
                                $.each(res, function (i, item) {
                                    container.append(`
                                        <a href="/Product/Details/${item.id}" class="search-item">
                                            <img src="${item.imageUrl}" alt="${item.name}">
                                            <div class="info">
                                                <div class="name">${item.name}</div>
                                                <div class="price">${item.price} đ</div>
                                            </div>
                                        </a>
                                    `);
                                });
                            } else {
                                container.append(`
                                    <div class="no-result-item text-center p-3">
                                        <i class="fas fa-cat fa-2x mb-2" style="color: #bc8f8f; opacity: 0.5;"></i>
                                        <div>Không tìm thấy, thử từ khác nhé?</div>
                                    </div>
                                `);
                            }
                        }
                    });
                }, 300);
            });

            // Ẩn khi click ra ngoài
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#nav-search-input, #search-results-container').length) {
                    $('#search-results-container').hide();
                }
            });
        });

        // --- GLOBAL CSS FIX FOR ADMIN BUTTONS ---
        const style = document.createElement('style');
        style.innerHTML = `
            .admin-btn-active { 
                opacity: 1 !important; 
                pointer-events: auto !important; 
                cursor: pointer !important; 
            }
            .btn-rosy:hover { 
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(188, 143, 143, 0.4);
            }
        `;
        document.head.appendChild(style);

        // --- HÀM XÁC NHẬN RESET DỮ LIỆU DÙNG CHUNG (GLOBAL) ---
        function confirmResetData() {
            Swal.fire({
                title: 'BẠN CÓ CHẮC CHẮN?',
                text: "Bạn có chắc chắn muốn xóa sạch toàn bộ lịch sử đơn hàng và doanh thu không? Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#bc8f8f',
                cancelButtonColor: '#333',
                confirmButtonText: 'Đồng ý, Dọn sạch ngay!',
                cancelButtonText: 'Hủy, Tôi bấm nhầm',
                background: '#1e1e1e',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('resetDataForm');
                    if (form) form.submit();
                    else Swal.fire('Lỗi', 'Không tìm thấy Form reset!', 'error');
                }
            })
        }
    </script>
    @await RenderSectionAsync("Modals", required: false)
    @await RenderSectionAsync("Scripts", required: false)

    @* Ẩn widget ở khu vực Admin *@
    @if (!(ViewContext.RouteData.Values["area"]?.ToString()
            ?.Equals("Admin", StringComparison.OrdinalIgnoreCase) ?? false))
    {
        <link rel="stylesheet" href="~/css/meow-chat-widget.css" asp-append-version="true" />
        <script src="~/js/meow-chat-widget.js" asp-append-version="true"></script>
    }
</body>
</html>