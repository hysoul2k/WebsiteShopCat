@model IEnumerable<Huy_Final_0843.ViewModels.ShopItemViewModel>
@{
    ViewData["Title"] = "Trang Chủ";
}

@section Meta {
    <meta property="og:title" content="Meow Garden - Thiên đường phụ kiện thú cưng" />
    <meta property="og:description" content="Khám phá bộ sưu tập sản phẩm cao cấp dành cho các bé mèo tại ShopCat. Uy tín, chất lượng, rước ngay về nhà!" />
    <meta property="og:image" content="https://shopcat.vn/images/og-banner.jpg" />
    <meta property="og:type" content="website" />
}

<!-- HERO BANNER -->
<section class="hero" style="margin: -48px -32px 48px -32px;">
    <div class="hero-inner container-fluid">
        <div class="row align-items-center g-5">
            <div class="col-lg-5 hero-left">
                <span class="hero-label">Chăm Sóc Thú Cưng Professional</span>
                <h1>Nơi tình yêu nở rộ<br>cùng <em>bé mèo</em> của bạn</h1>
                <p>Khám phá bộ sưu tập sản phẩm cao cấp, từ thức ăn dinh dưỡng đến phụ kiện thời trang, được chọn lọc kỹ càng vì hạnh phúc của các bé.</p>
                
                <div class="hero-actions">
                    <a href="#product-grid" class="btn-hero-primary">Sắm Đồ Cho Boss</a>
                    <a href="#" class="btn-hero-ghost">Cẩm Nang Nuôi Mèo</a>
                </div>

                <div class="hero-stats">
                    <div>
                        <div class="stat-num">5k+</div>
                        <div class="stat-label">KHÁCH HÀNG TIN DÙNG</div>
                    </div>
                    <div>
                        <div class="stat-num">100%</div>
                        <div class="stat-label">SẢN PHẨM CHÍNH HÃNG</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 hero-right">
                @{
                    var bannerList = ViewBag.BannerProducts as List<Huy_Final_0843.Models.Product> ?? new List<Huy_Final_0843.Models.Product>();
                }
                <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
                    <div class="carousel-indicators">
                        @for (int i = 0; i < bannerList.Count; i++)
                        {
                            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                        }
                    </div>
                    <div class="carousel-inner shadow-lg rounded-4">
                        @for (int i = 0; i < bannerList.Count; i++)
                        {
                            var p = bannerList[i];
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@p.ImageUrl" class="d-block w-100 carousel-img" alt="@p.Name"
                                     style="object-fit:cover; height:420px; filter:brightness(0.82);">
                                <div class="carousel-caption-custom">
                                    <div class="small mb-1" style="opacity:.8;letter-spacing:.05em;text-transform:uppercase;">@p.Category?.Name</div>
                                    <h5>@p.Name</h5>
                                    <p style="margin-bottom:12px;">@p.Price.ToString("N0") đ</p>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id"
                                       class="btn btn-sm px-4 fw-bold"
                                       style="background:var(--color-primary,#2D5016);color:#fff;border-radius:20px;">
                                        Xem ngay
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CATEGORIES -->
<section class="categories" style="margin: 0 -32px 48px -32px;">
    <div class="categories-inner">
        <div class="section-header">
            <h2 class="section-title">Danh Mục Mua Sắm</h2>
        </div>
        
        @{
            string GetCatIcon(string name) {
                var n = name.ToLower();
                if (n.Contains("thức ăn") || n.Contains("food") || n.Contains("pate") || n.Contains("hạt")) return "fa-drumstick-bite";
                if (n.Contains("đồ chơi") || n.Contains("chơi")) return "fa-gamepad";
                if (n.Contains("vệ sinh") || n.Contains("tắm") || n.Contains("hygiene")) return "fa-bath";
                if (n.Contains("phụ kiện") || n.Contains("vòng cổ") || n.Contains("dây")) return "fa-gem";
                if (n.Contains("giường") || n.Contains("nệm") || n.Contains("ngủ")) return "fa-bed";
                if (n.Contains("giống") || n.Contains("mèo con") || n.Contains("breed")) return "fa-cat";
                if (n.Contains("khay") || n.Contains("cát") || n.Contains("litter")) return "fa-box-open";
                if (n.Contains("thuốc") || n.Contains("sức khỏe") || n.Contains("health")) return "fa-heartbeat";
                return "fa-paw";
            }
        }
        <div class="cat-grid">
            <a href="@Url.Action("Index", new { categoryId = "" })" class="cat-card @(ViewBag.CurrentCategory == null ? "active" : "")">
                <div class="cat-icon"><i class="fas fa-th-large" style="font-size:20px; color: var(--color-primary);"></i></div>
                <div>
                    <div class="cat-name">Tất cả</div>
                </div>
            </a>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    <a href="@Url.Action("Index", new { categoryId = cat.Id })" class="cat-card @((ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == cat.Id) ? "active" : "")">
                        <div class="cat-icon"><i class="fas @GetCatIcon(cat.Name)" style="font-size:20px; color: var(--color-primary);"></i></div>
                        <div>
                            <div class="cat-name">@cat.Name</div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

<!-- MAIN LAYOUT -->
<div class="main-inner" id="product-grid">
    
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="filter-card">
            <h3 class="filter-title">Bộ Lọc Tìm Kiếm</h3>
            <form id="filterForm" asp-controller="Home" asp-action="Index" method="get">
                <input type="hidden" name="sortOrder" id="sortOrderHidden" value="@ViewBag.SortOrder" />
                <input type="hidden" name="categoryId" value="@ViewBag.CurrentCategory" />

                <label class="filter-label">Tìm theo tên</label>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="filter-input" placeholder="Ví dụ: Pate Whiskas...">

                <div class="filter-divider"></div>

                <label class="filter-label">Khoảng giá</label>
                <div class="price-range">
                    <input type="number" name="minPrice" value="@ViewBag.MinPrice" class="price-input" placeholder="Từ" step="10000">
                    <span class="price-sep">-</span>
                    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="price-input" placeholder="Đến" step="10000">
                </div>

                @{
                    bool showingCats = ViewBag.CurrentCategory == null || ViewBag.CurrentCategory == 0 || ViewBag.CurrentCategory == 1;
                }
                @if (showingCats)
                {
                    <div class="filter-divider"></div>
                    <label class="filter-label">Giới tính mèo</label>
                    <select name="gender" class="filter-input" style="cursor:pointer;">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Gender as string))">Tất cả</option>
                        <option value="Đực"     selected="@(ViewBag.Gender == "Đực")">♂ Đực</option>
                        <option value="Cái"     selected="@(ViewBag.Gender == "Cái")">♀ Cái</option>
                        <option value="Không rõ" selected="@(ViewBag.Gender == "Không rõ")">❓ Không rõ</option>
                    </select>
                }

                <button type="submit" class="btn-apply mt-4">Áp dụng lọc</button>
                <a asp-action="Index" class="btn-clear">Xóa bộ lọc</a>
            </form>
        </div>

        <div class="support-card">
            <h4 class="support-title">Cần hỗ trợ?</h4>
            <p class="support-sub">Đội ngũ chuyên gia của chúng tôi luôn sẵn sàng giúp bạn chọn sản phẩm phù hợp nhất.</p>
            
            <a href="https://facebook.com/hysoul2k" class="support-btn" target="_blank">
                <div class="support-icon fb-icon"><i class="fab fa-facebook-f text-on-dark"></i></div>
                <span>Chat qua Fanpage</span>
            </a>
            
            <a href="https://zalo.me/0908758533" class="support-btn" target="_blank">
                <div class="support-icon zalo-icon"><i class="fas fa-phone-alt text-on-dark"></i></div>
                <span>Liên hệ Zalo</span>
            </a>
        </div>
    </aside>

    <!-- PRODUCT LIST -->
    <main class="products-area">
        <div class="products-top">
            <div class="products-count">Hiển thị <strong>@Model.Count()</strong> món đồ</div>
            <select class="sort-select" onchange="applySort(this.value)">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SortOrder))">Mới nhất</option>
                <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá: Thấp đến cao</option>
                <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá: Cao đến thấp</option>
                <option value="rating" selected="@(ViewBag.SortOrder == "rating")">Đánh giá cao nhất</option>
            </select>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-warm-white rounded shadow-earthy-sm">
                <i class="fas fa-cat fa-4x mb-3" style="color: var(--sand);"></i>
                <h4 class="text-primary" style="font-family: 'Cormorant Garamond', serif;">Không tìm thấy kết quả nào!</h4>
                <p class="text-muted">Hãy thử xóa bộ lọc hoặc tìm kiếm tên khác.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var item in Model)
                {
                    var detailUrl = item.IsCat ? $"/Cats/Details/{item.Id}" : $"/Product/Details/{item.Id}";
                    <div class="product-card position-relative shadow-earthy-hover" data-product-id="@item.Id">
                        <a href="@detailUrl" class="product-img-wrap product-image-target">
                            @if (item.IsCat)
                            {
                                @if (item.Gender == "Đực") {
                                    <div class="badge-stock stock-badge" style="background:#dbeafe;color:#1d4ed8;">♂ Đực</div>
                                } else if (item.Gender == "Cái") {
                                    <div class="badge-stock stock-badge" style="background:#fce7f3;color:#be185d;">♀ Cái</div>
                                } else {
                                    <div class="badge-stock stock-badge" style="background:#f1f5f9;color:#64748b;">Mèo Cảnh</div>
                                }
                            }
                            else
                            {
                                @if (item.StockQuantity <= 0) {
                                    <div class="badge-stock danger stock-badge">Hết Hàng</div>
                                } else if (item.StockQuantity < 10) {
                                    <div class="badge-stock warning stock-badge">Sắp Hết (@item.StockQuantity)</div>
                                } else {
                                    <div class="badge-stock stock-badge">Còn Hàng (@item.StockQuantity)</div>
                                }
                            }
                            <img src="@item.ImageUrl" alt="@item.Name">
                        </a>

                        <div class="product-body">
                            @if (item.IsCat)
                            {
                                <div class="stars">
                                    <span style="font-size:12px;color:var(--color-primary);">
                                        <i class="fas fa-cat me-1"></i>
                                        @(item.Age == 0 ? "Dưới 1 tháng" : $"{item.Age} tháng tuổi")
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++) {
                                        if (i <= Math.Round(item.AvgRating)) { <i class="fas fa-star star filled"></i> }
                                        else { <i class="fas fa-star star"></i> }
                                    }
                                    <span class="review-count">(@item.TotalReviews)</span>
                                </div>
                            }

                            <a href="@detailUrl" class="product-name">@item.Name</a>

                            <div class="product-footer">
                                <div class="price">@item.Price.ToString("#,##0")<small style="font-size:12px;font-weight:400;font-family:'DM Sans',sans-serif;">đ</small></div>

                                @if (item.IsCat)
                                {
                                    <a href="@detailUrl" class="add-to-cart">
                                        <i class="fas fa-cat" style="width:14px;"></i> Xem Chi Tiết
                                    </a>
                                }
                                else if (item.StockQuantity > 0)
                                {
                                    <div class="qty-add add-to-cart-form">
                                        <div class="qty-control d-none">
                                            <input type="hidden" name="quantity" value="1">
                                        </div>
                                        <button type="button" class="add-to-cart btn-add-to-cart-ajax" data-product-id="@item.Id">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M12 10v6"/><path d="M9 13h6"/></svg>
                                            Rước Về
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <a href="@detailUrl" class="add-to-cart" style="background:var(--bark);">Chi tiết</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- PHÂN TRANG -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="pagination-custom">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, categoryId = ViewBag.CurrentCategory, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, gender = ViewBag.Gender })" class="page-btn">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <a href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, categoryId = ViewBag.CurrentCategory, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, gender = ViewBag.Gender })" class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                            @i
                        </a>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, categoryId = ViewBag.CurrentCategory, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, gender = ViewBag.Gender })" class="page-btn">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        }
    </main>
</div>

@section Scripts {
    <script>
        function applySort(val) {
            document.getElementById('sortOrderHidden').value = val;
            document.getElementById('filterForm').submit();
        }

        // AJAX category tab switching — no full page reload
        document.addEventListener('click', async function (e) {
            const tab = e.target.closest('.cat-card');
            if (!tab) return;
            e.preventDefault();

            // Update active state ngay lập tức
            document.querySelectorAll('.cat-card').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            // Build URL: giữ nguyên filter hiện tại, chỉ đổi categoryId + reset page 1
            const tabUrl = new URL(tab.href, location.origin);
            const catId = tabUrl.searchParams.get('categoryId') || '';
            const params = new URLSearchParams(location.search);
            if (catId) params.set('categoryId', catId);
            else params.delete('categoryId');
            params.delete('page');
            const fetchUrl = `/Home/Index?${params.toString()}`;

            // Fade loading
            const grid = document.getElementById('product-grid');
            grid.style.cssText += 'opacity:0.4;transition:opacity 0.15s;pointer-events:none;';

            try {
                const res = await fetch(fetchUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const newGrid = doc.getElementById('product-grid');
                if (newGrid) grid.innerHTML = newGrid.innerHTML;
                history.pushState({}, '', fetchUrl);
            } catch {
                location.href = fetchUrl; // fallback nếu fetch lỗi
            } finally {
                grid.style.opacity = '1';
                grid.style.pointerEvents = '';
            }
        });
    </script>
}