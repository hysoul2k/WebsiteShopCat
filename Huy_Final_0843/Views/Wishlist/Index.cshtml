@model IEnumerable<Huy_Final_0843.Models.Wishlist>
@using Huy_Final_0843.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh sách yêu thích";
    var items = Model?.ToList() ?? new List<Wishlist>();
    var count = items.Count;
}

<main class="wishlist-page container py-5">
    <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1>Danh sách yêu thích</h1>
            <p>@count sản phẩm</p>
        </div>
    </div>

    @if (count == 0)
    {
        <div class="wishlist-empty-state text-center py-5">
            <div class="empty-icon mb-3"><i class="fas fa-cat fa-2x" style="color: #bc8f8f; opacity: 0.8;"></i></div>
            <h2>Chưa có gì ở đây cả~</h2>
            <p class="text-muted">Hãy thêm bé mèo hoặc sản phẩm bạn yêu thích vào danh sách để xem lại sau nhé.</p>
            <a href="/Home/Index" class="btn btn-primary btn-lg mt-3" style="background: var(--terra); border: none;">Khám phá ngay</a>
        </div>
    }
    else
    {
        <div class="wishlist-grid">
            @foreach (var item in items)
            {
                var product = item.Product;
                if (product == null) { continue; }
                <article class="wishlist-card" data-wishlist-id="@item.Id">
                    <a href="/Product/Details/@item.ProductId" class="wishlist-image-link">
                        <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                    </a>
                    <div class="wishlist-card-body">
                        <h2>@product.Name</h2>
                        <p class="price">@product.Price.ToString("N0") ₫</p>
                        <div class="wishlist-actions">
                            <button type="button" class="btn btn-outline-primary btn-add-cart" data-product-id="@item.ProductId">
                                Thêm vào giỏ
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-remove-wishlist" data-id="@item.Id">
                                ✕ Xóa
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    <div id="wishlist-toast" class="wishlist-toast" hidden></div>
</main>

@section Styles {
    <style>
        .wishlist-page h1 {
            font-size: 2.5rem;
            margin-bottom: 0.25rem;
        }

        .wishlist-page p {
            color: #6c757d;
            margin-bottom: 0;
        }

        .wishlist-empty-state {
            border: 1px dashed #ced4da;
            border-radius: 18px;
            padding: 4rem 2rem;
            background: #fff;
        }

        .empty-icon {
            font-size: 4rem;
            color: #dc3545;
        }

        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
        }

        .wishlist-card {
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 20px;
            background: #fff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .wishlist-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
        }

        .wishlist-image-link {
            display: block;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            background: #f8f9fa;
        }

        .wishlist-image-link img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .wishlist-card-body {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .wishlist-card-body h2 {
            font-size: 1.1rem;
            margin: 0;
            line-height: 1.3;
            min-height: 3.3rem;
        }

        .wishlist-card-body .price {
            font-size: 1rem;
            font-weight: 700;
            color: #111;
            margin: 0;
        }

        .wishlist-actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-top: auto;
        }

        .btn-add-cart,
        .btn-remove-wishlist {
            width: 100%;
        }

        .wishlist-toast {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            background: rgba(13, 110, 253, 0.95);
            color: white;
            border-radius: 999px;
            padding: 0.85rem 1.2rem;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
            font-weight: 600;
            z-index: 1050;
            opacity: 0;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .wishlist-toast.show {
            opacity: 1;
            transform: translateY(-8px);
        }

        @@media (max-width: 991px) {
            .wishlist-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767px) {
            .wishlist-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        function showWishlistToast(message) {
            if (typeof window.showToast === 'function') {
                window.showToast(message, 'success');
            } else {
                const toast = document.getElementById('wishlist-toast');
                toast.textContent = message;
                toast.hidden = false;
                toast.classList.add('show');
                clearTimeout(window.wishlistToastTimeout);
                window.wishlistToastTimeout = setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.hidden = true, 200);
                }, 2200);
            }
        }

        document.querySelectorAll('.btn-remove-wishlist').forEach(button => {
            button.addEventListener('click', async () => {
                const id = button.dataset.id;
                if (!confirm('Xóa sản phẩm này khỏi danh sách yêu thích?')) return;
                const response = await fetch(`/Wishlist/Remove/${id}`, { method: 'POST' });
                if (!response.ok) {
                    showWishlistToast('Xóa thất bại. Vui lòng thử lại.');
                    return;
                }
                const data = await response.json();
                if (data.success) {
                    const card = button.closest('.wishlist-card');
                    card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.97)';
                    setTimeout(() => card.remove(), 250);
                    const countEl = document.querySelector('.wishlist-page p');
                    const currentCount = Number(countEl.textContent.split(' ')[0]);
                    const nextCount = currentCount - 1;
                    countEl.textContent = `${nextCount} sản phẩm`;
                    if (nextCount === 0) {
                        setTimeout(() => location.reload(), 300);
                    }
                } else {
                    showWishlistToast(data.message || 'Xóa không thành công.');
                }
            });
        });

        document.querySelectorAll('.btn-add-cart').forEach(button => {
            button.addEventListener('click', async () => {
                const productId = button.dataset.productId;
                const response = await fetch('/ShoppingCart/AddToCartAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `productId=${encodeURIComponent(productId)}&quantity=1`
                });
                const result = await response.json();
                if (result.success) {
                    showWishlistToast('Đã thêm vào giỏ hàng');
                } else {
                    showWishlistToast(result.message || 'Thêm vào giỏ hàng thất bại');
                }
            });
        });
    </script>
}