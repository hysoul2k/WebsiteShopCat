@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5">
    <div class="glass-card p-5 text-center">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill" style="font-size: 5rem; color: var(--accent-color);"></i>
        </div>
        <h2 class="text-white mb-3">ĐẶT HÀNG THÀNH CÔNG!</h2>
        <p class="text-secondary fs-5">
            Cảm ơn bạn đã ủng hộ Cat Store. <br />
            Mã đơn hàng của bạn là: <span class="text-white fw-bold">#@Model</span>
        </p>
        <hr class="border-secondary my-4" />
        <p class="text-gray small">Chúng tôi sẽ sớm liên hệ với bạn qua thông tin đã cung cấp để giao "boss" tận nơi.</p>

        <div class="mt-5">
            <a href="/" class="btn btn-neon rounded-pill px-5 py-2">TIẾP TỤC MUA SẮM</a>
        </div>
    </div>
</div>