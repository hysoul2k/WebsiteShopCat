@using Huy_Final_0843.Extensions
@using Huy_Final_0843.Models
@model Order
@{
    ViewData["Title"] = "Thanh toán";
    var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart");
    decimal total = cart != null ? cart.GetTotalValue() : 0;
}

<div class="container py-4">
    <div class="row g-4">
        <!-- FORM THANH TOÁN -->
        <div class="col-lg-8">
            <div class="card p-4 shadow-earthy border-standard" style="border-radius: 12px; background: var(--color-surface);">
                <h3 class="mb-4 text-primary" style="font-family: 'Cormorant Garamond', serif; font-weight: 700;">
                    <i class="fas fa-shipping-fast me-2 text-accent"></i>Thông Tin Giao Hàng
                </h3>
                <form asp-action="Checkout" method="post">
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label fw-bold text-muted" style="font-family: 'DM Sans', sans-serif;">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                        <input asp-for="ShippingAddress" class="form-control filter-input" placeholder="Nhập địa chỉ nhận hàng của bạn..." required />
                        <span asp-validation-for="ShippingAddress" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold text-muted" style="font-family: 'DM Sans', sans-serif;">Ghi chú thêm (Không bắt buộc)</label>
                        <textarea asp-for="Notes" class="form-control filter-input" rows="3" placeholder="Ví dụ: Giao hàng giờ hành chính, gọi trước khi đến..."></textarea>
                    </div>

                    <h4 class="mt-4 mb-3 text-primary" style="font-family: 'Cormorant Garamond', serif; font-weight: 700;">
                        <i class="fas fa-wallet me-2 text-accent"></i>Phương Thức Thanh Toán
                    </h4>
                    
                    <div class="d-flex flex-column gap-3 mb-4">
                        <label class="p-3 rounded" style="cursor: pointer; background: var(--color-bg); border: 1.5px solid var(--color-border);">
                            <div class="form-check d-flex align-items-center mb-0">
                                <input class="form-check-input me-3" style="width: 1.2rem; height: 1.2rem;" type="radio" asp-for="PaymentMethod" value="COD" id="paymentCod" checked>
                                <label class="form-check-label fw-bold text-on-light w-100" for="paymentCod" style="cursor: pointer;">
                                    <i class="fas fa-hand-holding-usd me-2 text-primary"></i>Thanh toán khi nhận hàng (COD)
                                </label>
                            </div>
                        </label>
                        <label class="p-3 rounded" style="cursor: pointer; background: var(--color-bg); border: 1.5px solid var(--color-border);">
                            <div class="form-check d-flex align-items-center mb-0">
                                <input class="form-check-input me-3" style="width: 1.2rem; height: 1.2rem;" type="radio" asp-for="PaymentMethod" value="BankTransfer" id="paymentBank">
                                <label class="form-check-label fw-bold text-on-light w-100" for="paymentBank" style="cursor: pointer;">
                                    <i class="fas fa-qrcode me-2 text-primary-light"></i>Chuyển khoản qua Mã QR
                                </label>
                            </div>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-3 fw-bold fs-5 shadow-sm" style="border-radius: 8px;">
                        XÁC NHẬN ĐẶT HÀNG
                    </button>
                </form>
            </div>
        </div>

        <!-- TÓM TẮT ĐƠN HÀNG -->
        <div class="col-lg-4">
            <div class="card p-4 shadow-earthy border-standard" style="border-radius: 12px; background: var(--color-surface);">
                <h4 class="mb-4 text-on-light" style="font-family: 'Cormorant Garamond', serif; font-weight: 700;">Tóm Tắt Đơn Hàng</h4>
                
                @if (cart != null && cart.Items.Any())
                {
                    <div class="d-flex flex-column gap-3 mb-4" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3 pb-3 border-bottom border-standard">
                                <img src="@item.ImageUrl" class="rounded border border-standard object-fit-cover" style="width: 50px; height: 50px;" />
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-on-light text-truncate" style="max-width: 180px;">@item.Name</div>
                                    <div class="small text-muted">Số lượng: @item.Quantity</div>
                                </div>
                                <div class="fw-bold text-primary">@((item.Price * item.Quantity).ToString("#,##0"))đ</div>
                            </div>
                        }
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-bold text-uppercase small" style="font-family: 'DM Sans', sans-serif;">Tạm tính</span>
                        <span class="fw-bold text-on-light">@total.ToString("#,##0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fw-bold text-uppercase small" style="font-family: 'DM Sans', sans-serif;">Phí vận chuyển</span>
                        <span class="fw-bold text-primary-light">Miễn phí</span>
                    </div>
                    <hr class="border-standard">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-on-light fw-bold fs-5" style="font-family: 'Cormorant Garamond', serif;">Tổng Cộng</span>
                        <span class="fw-bold text-primary fs-4">@total.ToString("#,##0") đ</span>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">Giỏ hàng của bạn đang trống!</div>
                }
            </div>
            
            <div class="mt-4 p-4 rounded text-center" style="background: var(--color-bg); border: 1.5px dashed var(--color-border-dark);">
                <i class="fas fa-shield-alt fa-2x mb-2 text-accent"></i>
                <h6 class="fw-bold text-on-light mb-1">Thanh toán an toàn 100%</h6>
                <p class="small text-muted mb-0">Thông tin của bạn được bảo mật tuyệt đối tại Meow Garden.</p>
            </div>
        </div>
    </div>
</div>