@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="py-5" style="background: var(--main-bg); min-height: 80vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card glass-card border-0 shadow-lg text-white p-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-block p-3 rounded-circle bg-opacity-25 mb-3" style="background: #bc8f8f;">
                            <i class="fas fa-key fa-2x text-white"></i>
                        </div>
                        <h2 class="fw-bold text-uppercase tracking-wider">Quên mật khẩu?</h2>
                        <p class="text-secondary small">Nhập email của bạn để nhận mã xác thực khôi phục mật khẩu</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 small py-2 mb-3 bg-danger bg-opacity-10 text-danger">
                            <i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-floating mb-4">
                            <input type="email" name="email" class="form-control bg-dark text-white border-secondary shadow-none" 
                                   id="floatingEmail" placeholder="name@example.com" required>
                            <label for="floatingEmail" class="text-secondary">Địa chỉ Email</label>
                        </div>

                        <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm text-uppercase tracking-widest border-0" 
                                style="background-color: #bc8f8f; color: white;">
                            GỬI MÃ XÁC THỰC
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-area="Identity" asp-page="/Account/Login" class="text-secondary small text-decoration-none hover-white">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-white:hover { color: white !important; }
</style>
