@model Huy_Final_0843.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="py-5" style="background: var(--main-bg); min-height: 80vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card glass-card border-0 shadow-lg text-white p-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-block p-3 rounded-circle bg-opacity-25 mb-3" style="background: #2c3e50;">
                            <i class="fas fa-user-shield fa-2x text-white"></i>
                        </div>
                        <h2 class="fw-bold text-uppercase tracking-wider">Xác thực OTP</h2>
                        <p class="text-secondary small">Vui lòng nhập mã OTP đã gửi tới <br/><b class="text-white">@Model.Email</b></p>
                    </div>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info border-0 small py-2 mb-3 bg-info bg-opacity-10 text-info">
                            <i class="fas fa-info-circle me-1"></i> @TempData["Message"]
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <input type="hidden" asp-for="Email" />

                        <div class="form-floating mb-3">
                            <input asp-for="OTP" class="form-control bg-dark text-white border-secondary shadow-none text-center fs-4 fw-bold tracking-widest" 
                                   placeholder="123456" maxlength="6" autocomplete="off">
                            <label asp-for="OTP" class="text-secondary">Mã OTP (6 chữ số)</label>
                            <span asp-validation-for="OTP" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" class="form-control bg-dark text-white border-secondary shadow-none" 
                                   placeholder="Mật khẩu mới">
                            <label asp-for="NewPassword" class="text-secondary">Mật khẩu mới</label>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary shadow-none" 
                                   placeholder="Xác nhận mật khẩu">
                            <label asp-for="ConfirmPassword" class="text-secondary">Xác nhận mật khẩu</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn w-100 py-3 fw-bold shadow-sm text-uppercase tracking-widest border-0" 
                                style="background-color: #bc8f8f; color: white;">
                            ĐẶT LẠI MẬT KHẨU
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-action="ForgotPassword" class="text-secondary small text-decoration-none hover-white">
                            Chưa nhận được mã? Gửi lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest { letter-spacing: 0.5em; }
    .hover-white:hover { color: white !important; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
