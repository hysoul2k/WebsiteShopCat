@{
    ViewData["Title"] = "Xác nhận OTP";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card glass-card border-0 shadow-lg text-white p-5 text-center">
            <div class="mb-4">
                <div class="d-inline-block p-3 rounded-circle bg-opacity-25 shadow-sm" style="background: #bc8f8f;">
                    <i class="fas fa-envelope-open-text fa-3x text-white"></i>
                </div>
            </div>
            
            <h3 class="fw-bold text-uppercase mb-3">Xác nhận OTP</h3>
            <p class="text-secondary small mb-4">Một mã xác thực 6 số đã được gửi tới Email mới của bạn. Vui lòng nhập mã để hoàn tất thủ tục đổi Email.</p>

            <form asp-action="VerifyOTP" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                
                <div class="form-floating mb-4">
                    <input type="text" name="otp" class="form-control bg-dark text-white border-secondary shadow-none text-center fs-3 fw-bold" 
                           id="floatingOTP" placeholder="123456" maxlength="6" required autocomplete="off">
                    <label for="floatingOTP" class="text-secondary">Nhập 6 số OTP</label>
                </div>

                <button type="submit" class="btn w-100 py-3 fw-bold fs-5 shadow-sm text-uppercase tracking-widest border-0" 
                        style="background-color: #bc8f8f; color: white;">
                    Xác nhận mã ngay
                </button>
            </form>

            <div class="mt-4 pt-3 border-top border-secondary">
                <a asp-action="Index" class="text-secondary small text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>
